{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "postUpdateOptions": ["gomodTidy"],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "One PR a week for the routine Go bumps, rather than one per module.",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "go modules"
    },
    {
      "description": "Workflow actions move rarely; one PR covers them all.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github actions"
    },
    {
      "description": "The go directive decides which toolchain CI installs, so it moves on its own.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "groupName": null
    },
    {
      "description": "A green CI only proves the code still builds and the tests still pass. A major release can change behaviour underneath both, so it waits for a person.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major"]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  }
}
